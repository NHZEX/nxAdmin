parameters:
    level: 5
    paths:
        - app
        - config
        - extend
    scanFiles:
        - vendor/topthink/framework/src/helper.php
        - app/common.php
    stubFiles:
        - stubs/global_function.stub
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        - "#^Call to an undefined method think\\\\db\\\\ConnectionInterface\\:\\:(query|getPdo)\\(\\)\\.$#"
includes:
    - phpstan-baseline.neon